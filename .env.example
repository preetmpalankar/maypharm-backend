# Nest API environment.
# Copy to .env for local dev. Real values are set as Railway service variables.

# Supabase project API URL (not the Postgres connection string).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret backend-only key. Never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Railway sets PORT automatically at runtime; this is only for local dev.
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3001
