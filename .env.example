# Nest API environment.
# Copy to .env for local dev. Real values are set as Railway service variables.

# Supabase project API URL (not the Postgres connection string).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret backend-only key. Never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Railway sets PORT automatically at runtime; this is only for local dev.
PORT=3000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3001

# Optional. Private Storage bucket for uploads (created by the migrations).
# ASSET_BUCKET=maypharm-admin-assets

# Knowledge index for the AI Assistant (optional). Indexing runs in the
# background only when OPENAI_API_KEY is set; uploads never depend on it.
# Embeddings use text-embedding-3-small; the knowledge graph uses
# OPENAI_GRAPH_MODEL (default gpt-5-mini).
OPENAI_API_KEY=
OPENAI_GRAPH_MODEL=gpt-5-mini
# Set to "off" to pause indexing without removing the keys.
KNOWLEDGE_INDEXING=on

# AI Assistant (uses OPENAI_API_KEY). Answers stream from the knowledge index.
OPENAI_ASSISTANT_MODEL=gpt-5-mini
# Reasoning effort for reasoning models: none | minimal | low | medium | high
OPENAI_ASSISTANT_REASONING=low
