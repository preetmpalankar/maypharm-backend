# Never copy an installed node_modules into the image — pnpm's tree is made of
# symlinks, and laying it over an already-populated directory is what triggers
# buildkit's "cannot replace to directory ... with file". Let pnpm install
# inside the container instead.
node_modules

# Build outputs — regenerated by `pnpm run build`
dist
coverage
.turbo

# VCS + editor
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Secrets. Railway injects these as service variables; .env.example is not
# needed inside the image either.
.env
.env.*

# Tests and docs — not needed to run the server
test
*.md
